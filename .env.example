# ==============================================================================
# CALCULA PERÚ - ARCHIVO DE CONFIGURACIÓN DE ENTORNO DE EJEMPLO (.env.example)
#
# IMPORTANTE:
# - Copia este archivo a .env.local para desarrollo local.
# - NUNCA guardes claves secretas reales en este archivo ni en el control de versiones.
# - En producción, todas las variables obligatorias deben estar debidamente configuradas.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AUTENTICACIÓN Y SEGURIDAD DE SESIÓN
# ------------------------------------------------------------------------------
# Variable CANÓNICA para firma y verificación de tokens de sesión y hashing criptográfico.
# Obligatoria en producción (mínimo 32 caracteres generados aleatoriamente).
# Ejemplo para generar en consola: openssl rand -hex 32
AUTH_SECRET=tu_secreto_canonico_de_al_menos_32_caracteres_aqui

# OBSOLETO (DEPRECADO):
# AUTH_TOKEN_SECRET sólo se mantiene por compatibilidad temporal y será removida el 2026-12-31.
# Emitirá advertencias tanto en desarrollo como en producción si se utiliza.
# NO usar en instalaciones nuevas; migrar obligatoriamente a AUTH_SECRET.

# ------------------------------------------------------------------------------
# 2. PERSISTENCIA DURABLE (SUPABASE / POSTGRESQL)
# ------------------------------------------------------------------------------
# URL pública del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima de Supabase para operaciones del cliente (RLS activo)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key_publica

# Clave Service Role (exclusiva de servidor, con bypass de RLS para el backend)
# NUNCA debe llevar prefijo NEXT_PUBLIC_ ni exponerse en el cliente web
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_secreta

# ------------------------------------------------------------------------------
# 3. NOTIFICACIONES Y CORREO ELECTRÓNICO (RESEND)
# ------------------------------------------------------------------------------
# Clave de API de Resend para el envío transaccional de notificaciones administrativas
RESEND_API_KEY=re_tu_clave_de_resend_aqui

# Remitente transaccional verificado en Resend
RESEND_FROM_EMAIL=CalculaPerú <notificaciones@calculaperu.com.pe>

# Correo receptor para notificaciones internas de consultas y solicitudes
CONTACT_RECIPIENT_EMAIL=soporte@calculaperu.com.pe

# ------------------------------------------------------------------------------
# 4. CONFIGURACIÓN DEL SITIO Y PROTECCIÓN CSRF
# ------------------------------------------------------------------------------
# Origen canónico de producción utilizado para validaciones estrictas de navegación y CSRF
NEXT_PUBLIC_SITE_URL=https://calculaperu.com.pe

# ------------------------------------------------------------------------------
# 5. CONTENT SECURITY POLICY Y DIAGNÓSTICO CSP
# ------------------------------------------------------------------------------
# "report-only" registra infracciones sin bloquear recursos. Usa "enforce" solo
# después de revisar los reportes y validar la aplicación en producción.
CSP_MODE=report-only

# Los reportes quedan desactivados por defecto para evitar almacenar datos de
# navegación accidentalmente. "enabled" permite registrar únicamente el resumen
# sanitizado en los logs del runtime; no es almacenamiento durable.
CSP_REPORT_LOGGING=disabled
